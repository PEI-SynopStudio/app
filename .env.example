POSTGRES_USER=pei
POSTGRES_PASSWORD=pei
POSTGRES_DB=pei
DATABASE_URL=postgresql+psycopg2://pei:pei@postgres:5432/pei

# Whisper
WHISPER_MODEL=openai/whisper-large-v3-turbo
DEFAULT_LANGUAGE=pt

# Rabbit
RABBITMQ_USER=pei
RABBITMQ_PASSWORD=pei
RABBITMQ_URL=amqp://pei:pei@rabbitmq:5672/

# SeaweedFS
SEAWEEDFS_ACCESS_KEY=pei
SEAWEEDFS_SECRET_KEY=pei
S3_PUBLIC_ENDPOINT_URL=http://localhost:8333

# Keycloak
KEYCLOAK_ADMIN_USER=pei
KEYCLOAK_ADMIN_PASSWORD=pei
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=keycloak
KEYCLOAK_PUBLIC_URL=http://auth.localhost
KEYCLOAK_CLIENT_SECRET=pei-dev-client-secret
APP_PUBLIC_URL=http://localhost
