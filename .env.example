POSTGRES_USER=pei
POSTGRES_PASSWORD=pei
POSTGRES_DB=pei
DATABASE_URL=postgresql+psycopg2://pei:pei@postgres:5432/pei

# Whisper
WHISPER_MODEL=openai/whisper-large-v3-turbo
DEFAULT_LANGUAGE=pt

# Rabbit
RABBITMQ_USER=pei
RABBITMQ_PASSWORD=pei
RABBITMQ_URL=amqp://pei:pei@rabbitmq:5672/

# SeaweedFS
SEAWEEDFS_ACCESS_KEY=pei
SEAWEEDFS_SECRET_KEY=pei
S3_PUBLIC_ENDPOINT_URL=http://localhost:8333

# Keycloak
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_PUBLIC_URL=http://localhost:8080
KEYCLOAK_CLIENT_SECRET=pei-dev-client-secret

# Address of the application in the browser (the Vite dev server, which proxies /api to the backend)
APP_PUBLIC_URL=http://localhost:5173

# Sign-in sessions of the backend; set SESSION_COOKIE_SECURE=true behind TLS
SESSION_TTL_SECONDS=604800
SESSION_COOKIE_SECURE=false