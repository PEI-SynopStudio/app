POSTGRES_USER=pei
POSTGRES_PASSWORD=pei
POSTGRES_DB=pei
DATABASE_URL=postgresql+psycopg2://pei:pei@postgres:5432/pei

# Whisper
WHISPER_MODEL=large-v3-turbo
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
SPEECH_CPU_THREADS=4
SPEECH_MODELS_DIR=/data/models
DEFAULT_LANGUAGE=pt

# Rabbit
RABBITMQ_USER=pei
RABBITMQ_PASSWORD=pei
RABBITMQ_URL=amqp://pei:pei@rabbitmq:5672/

# SeaweedFS
SEAWEEDFS_ACCESS_KEY=pei
SEAWEEDFS_SECRET_KEY=pei
# Address of the signed media links in the browser (SeaweedFS through Traefik)
MEDIA_HOST=media.localhost
S3_PUBLIC_ENDPOINT_URL=https://media.localhost

# Keycloak
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin
# Keycloak in the browser (sign-in pages, through Traefik) and its admin console (not routed by Traefik)
AUTH_HOST=auth.localhost
KEYCLOAK_PUBLIC_URL=https://auth.localhost
KEYCLOAK_ADMIN_URL=http://localhost:8080
KEYCLOAK_CLIENT_SECRET=pei-dev-client-secret

# Traefik (T4.36): the one address of the application in the browser; /api goes to the backend
APP_HOST=localhost
APP_PUBLIC_URL=https://localhost
API_PUBLIC_PATH=/api
# Fixed address of Traefik on the Docker network; the backend trusts forwarded headers from it only
APP_NETWORK_SUBNET=172.30.0.0/24
TRAEFIK_IP=172.30.0.10
# Traefik stops reading a request after this long (8 MB upload chunks on slow links)
TRAEFIK_READ_TIMEOUT=600s

# Sign-in sessions of the backend; the cookie is Secure because the app is served over HTTPS
SESSION_TTL_SECONDS=604800
SESSION_COOKIE_SECURE=true

# LLM: the profiles are in backend/app/core/llm.toml. An empty variable keeps the value of the chosen profile.
# Profile: ollama-qwen (project VM, the default), ollama-small (laptops) or openai-compatible (vLLM)
LLM_PROFILE=
# Server address of the profile; for Ollama running on the host: http://host.docker.internal:11434
LLM_BASE_URL=
# Model of the profile, e.g. qwen3:1.7b
LLM_MODEL=
# Seconds allowed for each request to the model (240 when neither this nor the profile sets it)
LLM_TIMEOUT_SECONDS=
# Another profiles file instead of backend/app/core/llm.toml
LLM_CONFIG_FILE=
# Only for the openai-compatible profile; never commit a real key
LLM_API_KEY=
# true writes prompts and replies (transcript text, personal data) to the logs; also needs LOG_LEVEL=DEBUG
LLM_LOG_CONTENT=false
